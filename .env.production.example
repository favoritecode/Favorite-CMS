# Copy to a secure environment-specific configuration source; never package the populated file.
FAVORITE_ENV=production
FAVORITE_DEBUG=false
FAVORITE_HOST=127.0.0.1
FAVORITE_PORT=8000
FAVORITE_DATABASE_URL=
FAVORITE_STORAGE_ROOT=
FAVORITE_STORAGE_PROVIDER=mounted
FAVORITE_CACHE_ENABLED=true
FAVORITE_AUTH_JWT_SECRET=
FAVORITE_AUTH_TOKEN_LIFETIME_SECONDS=900
FAVORITE_ACTIVE_THEME=favorite.theme.starter
# Server-only Next.js variable. Never prefix backend secrets with NEXT_PUBLIC_.
FAVORITE_API_URL=http://127.0.0.1:8000
