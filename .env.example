# Phase 0 bootstrap configuration. Never commit real secrets.
FAVORITE_ENV=development
FAVORITE_DEBUG=true
FAVORITE_HOST=127.0.0.1
FAVORITE_PORT=8000
FAVORITE_DATABASE_URL=sqlite:///storage/favorite-cms.db
FAVORITE_STORAGE_ROOT=storage/files
FAVORITE_STORAGE_PROVIDER=local
FAVORITE_CACHE_ENABLED=true
# Required in production. Development uses an ephemeral process-only key when blank.
FAVORITE_AUTH_JWT_SECRET=
FAVORITE_AUTH_TOKEN_LIFETIME_SECONDS=900
FAVORITE_ACTIVE_THEME=
# Optional isolated Tool Worker gateway. The token is server-only.
FAVORITE_TOOL_WORKER_URL=
FAVORITE_TOOL_WORKER_TOKEN=
FAVORITE_TOOL_TIMEOUT_SECONDS=15
# Server-only Next.js backend URL. Do not expose backend configuration through NEXT_PUBLIC_*.
FAVORITE_API_URL=http://127.0.0.1:8000
